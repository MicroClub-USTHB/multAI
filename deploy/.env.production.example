# MultiAI backend, production environment.
# Copy to /opt/multai/.env on the server (chmod 600) and fill every CHANGE_ME.
# Never commit the filled file. Generate secrets with:
#   openssl rand -hex 32          # passwords, jwt_secret, service key
#   openssl rand -base64 32       # encryption_key, FACE_ENCRYPTION_KEY
#
# Hostnames, ports, and service addresses (postgres, redis, nats, minio) are
# fixed in compose.prod.yml; do not set them here.

# ---- deploy ----------------------------------------------------------------
# Public host Caddy serves (see multai.caddy). Used below to build URLs.
MULTAI_HOST=multai.164-68-103-224.sslip.io
# Public host browsers/phones use for direct photo uploads (proxied to MinIO by
# Caddy, see multai.caddy). Presigned URLs are signed for this host. sslip.io
# names need no DNS record; with a real domain, point an A record at the VPS.
S3_HOST=s3.multai.164-68-103-224.sslip.io
# Image tag to run. deploy.sh overwrites this with the sha it deploys.
IMAGE_TAG=latest
# Set to "firebase" only after /opt/multai/secrets/firebase-credentials.json
# exists: it turns the push-notification worker on.
COMPOSE_PROFILES=

# ---- app mode (REQUIRED for production) -------------------------------------
# environment != "dev" is what makes auth cookies Secure and disables the fixed
# dev OTP code. debug=false hides /docs, /redoc and /openapi.json.
environment=production
debug=false
# Dev/testing convenience in the code (default true): a direct-upload group
# approves itself instead of waiting for a team lead. CHANGE_ME to false unless
# you really want that.
AUTO_APPROVE=false
# Caddy sets X-Forwarded-For; the API reads the client IP from it.
TRUST_PROXY_HEADERS=true

# ---- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=multi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=multi_ai

# ---- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# ---- NATS ----------------------------------------------------------------------
NATS_USER=multi
NATS_PASSWORD=CHANGE_ME

# ---- MinIO ----------------------------------------------------------------------
MINIO_ROOT_USER=multi_minio
MINIO_ROOT_PASSWORD=CHANGE_ME
# Region used to sign presigned URLs. Leave as is unless MinIO is configured
# with a custom region; it is passed explicitly so signing never calls out.
MINIO_REGION=us-east-1

# ---- Security ---------------------------------------------------------------------
# HS256 signing key for mobile and staff JWTs: 32+ bytes.
jwt_secret=CHANGE_ME
jwt_algorithm=HS256
# base64 of exactly 32 bytes (AES-256-GCM, refresh-token replay cache).
encryption_key=CHANGE_ME
# base64 of exactly 32 bytes.
FACE_ENCRYPTION_KEY=CHANGE_ME
totp_issuer=MultiAI

# ---- CORS / URLs ---------------------------------------------------------------------
# The FIRST entry is also where the API redirects the browser after MCDI login
# (app/router/web/auth.py uses CORS_ORIGINS[0]), so it must be the public web
# origin, https, no trailing slash. JSON list.
CORS_ORIGINS=["https://multai.164-68-103-224.sslip.io"]

# ---- MCDI (staff SSO) --------------------------------------------------------------------
MCDI_PROJECT_ID=CHANGE_ME
MCDI_API_KEY=CHANGE_ME
MCDI_BASE_URL=https://mcid-api.microclub.info/api
MCDI_SERVER_ID=1282095800079351851
# Caddy strips /api, so the backend route /admin/auth/mcdi/callback is public at
# /api/admin/auth/mcdi/callback. Register EXACTLY this URL in MCDI.
MCDI_REDIRECT_URI_WEB=https://multai.164-68-103-224.sslip.io/api/admin/auth/mcdi/callback

# ---- Google Drive OAuth -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Register this exact URL in the Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=https://multai.164-68-103-224.sslip.io/api/staff/drive/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file openid email profile
# Drive folder id approved uploads sync into (empty = connected account's root).
GOOGLE_CLUB_DRIVE_FOLDER_ID=

# ---- Email (HTTP email API) ------------------------------------------------------------------------
# The API key needs the send:transactional permission. EMAIL_FROM must be on a domain verified with the
# provider (DNS records published), otherwise every OTP email is refused (422 unverified_sender).
EMAIL_HTTP_API_KEY=CHANGE_ME
EMAIL_HTTP_BASE_URL=https://app.bortocall.org/v1
EMAIL_FROM=microclub <noreply@bortocall.com>

# ---- HR-Events sync -------------------------------------------------------------------------------
# Same value as MULTIAI_SERVICE_KEY in HR-Events. Empty rejects every call.
HR_EVENTS_SERVICE_KEY=CHANGE_ME
