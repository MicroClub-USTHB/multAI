# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT: This file is NOT bundled with the app.
# These values are compiled into the app at build time.
# Use --dart-define or CI/CD environment variables for actual values.
# =============================================================================

# REQUIRED: Production API base URL (MUST use HTTPS)
BASE_URL=https://api.multai.app

# REQUIRED: Google Sign-In client ID for iOS
GOOGLE_CLIENT_ID=

# REQUIRED: Google Sign-In server client ID for Android
GOOGLE_SERVER_CLIENT_ID=

# Optional: Custom paths (override defaults if needed)
GOOGLE_LOGIN_PATH=
WORKSPACE_REGISTER_PATH=

# REQUIRED: Password reset endpoints
PASSWORD_RESET_REQUEST_PATH=/auth/password-reset/request
PASSWORD_RESET_CONFIRM_PATH=/auth/password-reset/confirm
