VITE_APP_TITLE=MultAI

# Use a stable same-origin path in code. Dev server proxies it to the backend.
VITE_API_BASE_URL=/api

# Used by server-side functions to build an absolute URL in development.
SERVER_URL=http://localhost:3000

# Vite dev-proxy target (backend FastAPI).
VITE_API_PROXY_TARGET=http://localhost:8000

